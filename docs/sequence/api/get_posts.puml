@startuml
skinparam ParticipantBorderColor #007ACC
skinparam ParticipantBackgroundColor #E6F7FF

actor User as user
participant "API Server" as server
participant "Database" as DB

activate server
user -> server: GET
note right of user
    endpoint:
        /api/posts
    request:
        caption
        location
        postDate
        postDatetime
        tagList
end note
alt request.postDateがNULL && request.postDatetimeがNULLでない場合
    server -> server: postDate = request.postDatetimeの日付部分
end alt

server -> DB: select
activate DB
note right of DB
    table:
        post
    colum:
        post.post_id
        post.caption
        post.location
        post.post_date
        post.post_datetime
    conditions:
        status = "enabled"
        caption LIKE '%request.caption%'
        location LIKE '%request.location%'
        post_date = postDate
        post_datetime <= request.postDatetime
        post_id in  (
            table:
                tag
                INNER JOIN post_tags
                    ON tag.tag_id = post_tags.tag_id
            colum:
                post_tags.image_id
            conditions:
                tag.tag_name IN (request.tagList)
            having:
                COUNT(tag.tag_id) = request.tagList.length
    order by:
        post_datetime DESC
    limit: 50
end note

DB -> server: 投稿情報リスト
deactivate DB

loop For Each 投稿情報リスト
    server -> DB: select
    activate DB
    note right of DB
        table:
            tag
            INNER JOIN post_tags
                ON tag.tag_id = post_tags.tag_id
        colum:
            tag.name
        conditions:
            post_tags.post_id = 投稿情報.post_id
        order by:
            post_tags.tag_order
    end note
    DB -> server: タグリスト
    deactivate DB

    server -> server: 投稿情報とタグリストをレスポンスに詰める
end loop

alt posts found
    server -> user: 200 OK
    note right of user
        response:
            data: [
                {
                    post_id : 投稿情報.post_id
                    caption : 投稿情報.caption
                    location : 投稿情報.location
                    post_date : 投稿情報.post_date
                    post_datetime : 投稿情報.post_datetime
                    tagList : [タグリスト]
                },
                ...
            ]
    end note
else database error
    server -> user: 500 Internal Server Error
end alt

deactivate server
@enduml